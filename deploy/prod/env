NODE_ENV=production

# Better Auth configuration
BETTER_AUTH_SECRET=ssm:/volunteer-next/BETTER_AUTH_SECRET
# BETTER_AUTH_SECRET=<Your auth secret here, generated here https://www.better-auth.com/docs/installation>
BETTER_AUTH_URL=ssm:/volunteer-next/BETTER_AUTH_URL

# Auth mode: oauth (Pretix/OAuth) or credentials (email/password). Defaults to oauth.
AUTH_MODE=oauth

# Turnstile configuration
# TURNSTILE_SITE_KEY=<Your Turnstile site key here>
# TURNSTILE_SECRET_KEY=<Your Turnstile secret key here>

# OAuth configuration (required only when AUTH_MODE=oauth)
OAUTH_ADMIN_EMAILS=ssm:/volunteer-next/OAUTH_ADMIN_EMAILS
OAUTH_PROVIDER_NAME=Wildfire-SSO
OAUTH_PROVIDER_ID=Wildfire-SSO
OAUTH_CLIENT_ID=ssm:/volunteer-next/OAUTH_CLIENT_ID
OAUTH_CLIENT_SECRET=ssm:/volunteer-next/OAUTH_CLIENT_SECRET
OAUTH_DISCOVERY_URL=https://tickets.wildfireretreat.org/saf/.well-known/openid-configuration
# OAUTH_LOGOUT_URL=<URL for logging out of the OAuth provider>
# OAUTH_SESSION_EXPIRY_SECONDS=<Number of seconds before an OAuth session expires. Defaults to 7 days.>
# OAUTH_SESSION_UPDATE_AGE_SECONDS=<Number of seconds after which to update the session. Defaults to 24 hours.>

# Pretix ticket enforcement (when using AUTH_MODE=oauth)
PRETIX_REQUIRE_VALID_TICKET=true
PRETIX_API_TOKEN=ssm:/volunteer-next/PRETIX_API_TOKEN
#PRETIX_ORGANIZER=<Pretix organizer slug; defaults to first path segment of OAUTH_DISCOVERY_URL>
PRETIX_API_BASE_URL=https://tickets.wildfireretreat.org
PRETIX_REQUIRED_ITEM_IDS="gen_admit_pre,gen_admit_Tier1,gen_admit_Tier2,gen_admit_Tier3,gen_admit_mgr,gen_admit_kids"
PRETIX_LOOKUP_DEBUG=true

# Postgres configuration
# Full connection string (use for Neon; overrides individual vars below)
# POSTGRES_URL=postgresql://volunteer-next:volunteer-next@localhost:5432/volunteer-next?sslMode=allow
POSTGRES_HOST=ssm:/volunteer-next/POSTGRES_HOST
POSTGRES_USER=ssm:/volunteer-next/POSTGRES_USER
POSTGRES_PASSWORD=ssm:/volunteer-next/POSTGRES_PASSWORD
POSTGRES_DB=ssm:/volunteer-next/POSTGRES_DB
POSTGRES_PORT=ssm:/volunteer-next/POSTGRES_PORT
# TLS for the individual-vars config above (node-postgres reads PGSSLMODE).
# Neon rejects non-TLS connections with SQLSTATE 28000.
PGSSLMODE=ssm:/volunteer-next/PGSSLMODE

# SMTP (for password reset / verification emails when AUTH_MODE=credentials)
# If unset, reset links are logged to the server console in development.
SMTP_HOST=ssm:/volunteer-next/SMTP_HOST
SMTP_PORT=ssm:/volunteer-next/SMTP_PORT
SMTP_SECURE=ssm:/volunteer-next/SMTP_SECURE
SMTP_USER=ssm:/volunteer-next/SMTP_USER
SMTP_PASSWORD=ssm:/volunteer-next/SMTP_PASSWORD
SMTP_FROM=ssm:/volunteer-next/SMTP_FROM

# Analytics
# UMAMI_WEBSITE_ID=<Your Umami website ID here>

# Application configuration
APP_NAME=volunteer-next
# RESET_PASSWORD_TOKEN_EXPIRES_IN=<e.g. 15*60 for 15 minutes>
# LOCKOUT_THRESHOLD=<Number of failed login attempts before locking out>
# LOCKOUT_DURATION_MS=<Duration of lockout in milliseconds>
# PRUNE_INTERVAL_MS=<Interval at which to prune expired lockouts in milliseconds>
# RESET_PASSWORD_WINDOW_MS=<Window size for counting reset password attempts in milliseconds>
# RESET_PASSWORD_MAX_ATTEMPTS=<Maximum number of reset password attempts within the time window>
# SIGNUP_WINDOW_MS=<Window size for counting signup attempts in milliseconds>
# SIGNUP_MAX_ATTEMPTS=<Maximum number of signup attempts within the time window>
# USE_EMAIL_QUEUE=<Whether to use the email queue for sending emails (true/false)>
MAX_IMAGE_SIZE_BYTES=1MB
DEFAULT_TEAM_CONTACT_ADDRESS=info@wildfireretreat.org
#<Whether a team lead is required for each Team. Defaults to true.>
REQUIRE_TEAM_LEAD=false 

# Debugging flags
# DEFAULT_THEME=<Default theme to use: system | light | dark>
# DEBUG_FORCE_ROLE=admin
# DEBUG_FORCE_ROLE_EVENTID=<Event ID to use when forcing a role that requires an event ID>
# DEBUG_FORCE_ROLE_TEAMID=<Team ID to use when forcing a role that requires a team ID>